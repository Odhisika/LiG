DJANGO_SECRET_KEY=change-me-to-a-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# False = sqlite (zero-setup local dev). True = Postgres via DATABASE_URL below.
# docker-compose.yml overrides this to True automatically since it runs a real
# Postgres container. Set True explicitly in production.
USE_POSTGRES=False
DATABASE_URL=postgres://pricepilot:pricepilot@db:5432/pricepilot

# False = in-process cache (fine for a single dev process). True = Redis,
# required once more than one process needs to share the scheduler's
# per-product check lock (i.e. always in Docker/production).
USE_REDIS_CACHE=False
REDIS_CACHE_URL=redis://redis:6379/1

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# PricePilot user email that owns products created by the automated Jred import.
JRED_CATALOG_OWNER_EMAIL=owner@example.com

# Frontend dev server origin(s) allowed to call this API cross-origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Store Sync (LiG) --------------------------------------------------------
# Push PricePilot's monitored values into your own Django+Postgres store.
# Both of these must be set for sync to run at all.
#   LIG_DATABASE_URL=postgres://lig_user:lig_pass@host:5432/lig_db
#   LIG_SYNC_ENABLED=True
# Optional:
#   LIG_DEFAULT_CATEGORY_SLUG=uncategorized   # category used when seeding can't match the product's
#   LIG_SYNC_STOCK=True                       # False = never overwrite the store's order-driven stock
#   LIG_SYNC_IMAGES=True                      # False = seed without images
#   LIG_MEDIA_ROOT=/var/www/LiG/media         # where downloaded images land (LiG's media dir)
