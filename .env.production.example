SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False

ALLOWED_HOSTS=example.com,www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

USE_POSTGRES=True
DB_NAME=lig
DB_USER=lig
DB_PASSWORD=replace-with-a-strong-password
# "db" = the postgres container from docker-compose.prod.yml.
# Running Postgres on the host instead? Use 172.17.0.1 (docker bridge) or the
# server's LAN IP — 127.0.0.1 inside a container is NOT the host.
DB_HOST=db
DB_PORT=5432

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@example.com
EMAIL_HOST_PASSWORD=replace-with-your-smtp-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=LiG <no-reply@example.com>

PAYSTACK_PUBLIC_KEY=replace-me
PAYSTACK_SECRET_KEY=replace-me

HUBTEL_CLIENT_ID=replace-me
HUBTEL_CLIENT_SECRET=replace-me
HUBTEL_MERCHANT_ACCOUNT_NUMBER=replace-me
HUBTEL_BASE_URL=https://payproxyapi.hubtel.com

GOOGLE_OAUTH_CLIENT_ID=replace-me
GOOGLE_OAUTH_CLIENT_SECRET=replace-me
GOOGLE_OAUTH_KEY=

TURNSTILE_SITE_KEY=replace-with-your-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-your-turnstile-secret-key

# ---------------------------------------------------------------------------
# PricePilot (embedded monitoring/sync app at pricepilot/ inside this repo)
# ---------------------------------------------------------------------------
# PricePilot keeps its OWN Postgres database (named below) and opens a SECOND
# connection to LiG's database above to seed/store products on the store.
# The Celery worker + beat run the scrapers and the LiG store sync. Only the
# optional web UI/API needs the nginx subdomain config in deploy/.
#
# NOTE: the LiG app ignores these extra variables; PricePilot ignores the
# LiG ones (DB_NAME/DB_USER/...). Only the shared names (EMAIL_*, etc.)
# are read by both apps.

# --- PricePilot Django ---
DJANGO_SECRET_KEY=replace-with-a-different-long-random-secret
DJANGO_DEBUG=False
# Include any real domains that must talk to PricePilot (its own subdomain,
# plus the main site if it calls the API).
DJANGO_ALLOWED_HOSTS=pricepilot.example.com
# Frontend origins allowed to call the PricePilot API.
CORS_ALLOWED_ORIGINS=https://pricepilot.example.com,http://localhost:5173,http://127.0.0.1:5173

# --- PricePilot database (its own Postgres database) ---
USE_POSTGRES=True
DATABASE_URL=postgres://pricepilot:replace-with-pricepilot-db-password@db:5432/pricepilot

# Used ONCE by deploy/postgres-init.sh to create that database+user when the
# pgdata volume is first initialised (must match DATABASE_URL above).
PRICEPILOT_DB_NAME=pricepilot
PRICEPILOT_DB_USER=pricepilot
PRICEPILOT_DB_PASSWORD=replace-with-pricepilot-db-password

# --- Celery + cache (Redis runs as the "redis" container in production) ---
USE_REDIS_CACHE=True
REDIS_CACHE_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- Store sync: PricePilot -> LiG ---
# Points at LiG's OWN database (the same one configured above via DB_NAME).
LIG_DATABASE_URL=postgres://lig:replace-with-a-strong-password@db:5432/lig
LIG_SYNC_ENABLED=True
LIG_DEFAULT_CATEGORY_SLUG=uncategorized
LIG_SYNC_STOCK=True
LIG_SYNC_IMAGES=True
# Shared media volume (LiG serves these files to customers).
LIG_MEDIA_ROOT=/var/www/LiG/media

# --- PricePilot notifications ---
DEFAULT_FROM_EMAIL=PricePilot <no-reply@example.com>

