[Unit]
Description=PricePilot Django API (embedded in LiG repo)
After=network.target postgresql.service redis-server.service
Wants=redis-server.service

[Service]
User=lig
Group=lig
WorkingDirectory=/srv/lig/app/pricepilot
EnvironmentFile=/srv/lig/app/.env.production
ExecStart=/srv/lig/app/pricepilot/.venv/bin/gunicorn config.wsgi:application --workers 2 --bind 127.0.0.1:8001 --timeout 120
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
