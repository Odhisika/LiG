[Unit]
Description=PricePilot Celery beat scheduler (embedded in LiG repo)
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
User=lig
Group=lig
WorkingDirectory=/srv/lig/app/pricepilot
EnvironmentFile=/srv/lig/app/.env.production
ExecStart=/srv/lig/app/pricepilot/.venv/bin/celery -A config beat -l info --scheduler django_celery_beat.schedulers:DatabaseScheduler
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
